---
import { dilimYolu, etiket, type Dilim } from '../lib/cark.ts';
interface Props { dilimler: Dilim[] }
const { dilimler } = Astro.props;
const n = dilimler.length;
---
<div class="cark-kap">
  <svg class="cark" viewBox="-108 -114 216 222" role="img" aria-labelledby="cark-baslik" data-cark>
    <title id="cark-baslik" data-cark-baslik>Konu çarkı: {dilimler.map((d) => d.etiket).join(', ')}</title>
    <defs>
      <pattern id="cini" width="16" height="16" patternUnits="userSpaceOnUse">
        <g class="motif" transform="translate(8 8)">
          <rect x="-2.6" y="-2.6" width="5.2" height="5.2" />
          <rect x="-2.6" y="-2.6" width="5.2" height="5.2" transform="rotate(45)" />
        </g>
        <circle class="motif" r="1" />
        <circle class="motif" cx="16" r="1" />
        <circle class="motif" cy="16" r="1" />
        <circle class="motif" cx="16" cy="16" r="1" />
      </pattern>
    </defs>
    <circle class="kenar" r="104" />
    <g class="cark-don" data-cark-don>
      {dilimler.map((d, i) => {
        const e = etiket(i, n);
        return (
          <g class:list={['dilim', i % 2 ? 'd-b' : 'd-a']} data-dilim={d.id}>
            <path class="dilim-zemin" d={dilimYolu(i, n)} />
            <path class="dilim-desen" d={dilimYolu(i, n)} fill="url(#cini)" />
            <text transform={e.donus} x={e.x} y="2.6" text-anchor={e.capa}>{d.etiket}</text>
          </g>
        );
      })}
    </g>
    <circle class="gobek" r="21" />
    <g class="gobek-yildiz" aria-hidden="true">
      <rect x="-8" y="-8" width="16" height="16" />
      <rect x="-8" y="-8" width="16" height="16" transform="rotate(45)" />
      <circle r="3.4" />
    </g>
    <path class="gosterge" d="M-7.5 -113 L7.5 -113 L0 -95 Z" />
  </svg>
</div>
<style is:global>
  .cark-kap {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    aspect-ratio: 216 / 222;
  }
  .cark {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .kenar {
    fill: none;
    stroke: var(--sis);
    stroke-width: 1;
  }
  .cark-don {
    transform-box: fill-box;
    transform-origin: center;
    transform: rotate(var(--aci, 0deg));
    transition: transform var(--sure, 2600ms) cubic-bezier(0.1, 0.6, 0.12, 1);
    will-change: transform;
  }
  .dilim-zemin {
    stroke: var(--zemin);
    stroke-width: 1.2;
    stroke-linejoin: round;
    transition: opacity 250ms;
  }
  .d-a .dilim-zemin {
    fill: var(--dilim-a);
  }
  .d-b .dilim-zemin {
    fill: var(--dilim-b);
  }
  .dilim-desen {
    pointer-events: none;
    opacity: 0.16;
  }
  .motif {
    fill: #fff;
  }
  .dilim text {
    fill: var(--dilim-yazi);
    font-family: var(--f-baslik);
    font-weight: 650;
    font-size: 7.6px;
    letter-spacing: 0.01em;
    pointer-events: none;
  }
  .cark[data-secim] .dilim:not(.secili) .dilim-zemin {
    opacity: 0.28;
  }
  .cark[data-secim] .dilim:not(.secili) text {
    fill: var(--murekkep);
    opacity: 0.6;
  }
  .cark[data-secim] .dilim:not(.secili) .dilim-desen {
    opacity: 0.06;
  }
  .gobek {
    fill: var(--zemin);
    stroke: var(--sis);
    stroke-width: 1;
  }
  .gobek-yildiz rect {
    fill: var(--kobalt);
  }
  .gobek-yildiz circle {
    fill: var(--zemin);
  }
  .gosterge {
    fill: var(--murekkep);
    stroke: var(--zemin);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  @media (prefers-reduced-motion: reduce) {
    .cark-don,
    .dilim-zemin {
      transition: none;
    }
  }
</style>
